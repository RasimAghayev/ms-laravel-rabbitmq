# Secrets for docker-compose.yaml. Copy this file to `.env` (gitignored)
# and fill in real values before running `docker compose up`.
#
# These are consumed by docker-compose itself via ${VAR} interpolation and
# injected into the admin_app / main_app / main_worker containers as
# environment variables — neither app reads a committed .env of its own.

MYSQL_ROOT_PASSWORD=

ADMIN_DB_DATABASE=admin
ADMIN_DB_USERNAME=admin
ADMIN_DB_PASSWORD=

MAIN_DB_DATABASE=main
MAIN_DB_USERNAME=main
MAIN_DB_PASSWORD=

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Generate with: docker run --rm -v "$(pwd)/admin:/var/www" -w /var/www php:8.5-cli-alpine php artisan key:generate --show
ADMIN_APP_KEY=

# Generate the same way against ./main
MAIN_APP_KEY=
